---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Landing from "../components/Landing.astro";
import manifest from "../data/story-frames.json";
import { SEQUENCE_MEDIA, frameUrl } from "../scripts/story.ts";

const blogPosts = (await getCollection("blog"))
  .sort(
    (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
      b.data.date.getTime() - a.data.date.getTime(),
  )
  .map((post: CollectionEntry<"blog">) => ({
    slug: post.id.split("/").slice(1)[0],
    title: post.data.title,
    authors: post.data.authors,
    date: post.data.date,
  }));
---

<BaseLayout>
  {/* Fetch the hero frame for this screen alongside the JS bundle. */}
  {
    SEQUENCE_MEDIA.map(([sequence, media]) => (
      <link
        slot="head"
        rel="preload"
        as="image"
        href={frameUrl(manifest, sequence, 0)}
        media={media}
        fetchpriority="high"
      />
    ))
  }
  <Landing blogPosts={blogPosts} />
</BaseLayout>
