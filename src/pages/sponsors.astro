        <SiteHeader/>

        <main
                class="mx-auto flex w-[min(1040px,calc(100vw-40px))] flex-col gap-8 py-8 pb-[72px] max-md:pb-14"
        >
            <section class="flex flex-col gap-[14px]">
                <Text variant="display">Sponsors</Text>
            </section>
            <div class="grid lg:grid-cols-5 md:grid-cols-3 grid-cols-2">
                {
                    Object.keys(SPONSORS).map((sponsor) => {

                        return (
                                <p>{sponsor}</p>
                        );
                    })
                }
            </div>
        </main>
    </div>
</BaseLayout>
