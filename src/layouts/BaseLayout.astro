---
import "../styles/global.css";
import "katex/dist/katex.min.css";
import logo from "../assets/images/ppologodark.png";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  url?: string;
}

const {
  title = "Project Pixel Orbital",
  description = "Student-led CubeSat mission launching by 2026.",
  image,
  url,
} = Astro.props;

const pageUrl = url ?? Astro.url.href;
const socialImage = new URL(image ?? logo.src, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en" class="scroll-smooth dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:site_name" content="Project Pixel Orbital" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:image:alt" content="Project Pixel Orbital logo" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Project Pixel Orbital logo" />
    <script
      data-collect-dnt="true"
      async
      src="https://projectpixelorbital.com/proxy.js"></script>
    <script async src="https://projectpixelorbital.com/auto-events.js"></script>
    <noscript
      ><img
        src="https://projectpixelorbital.com/simple/noscript.gif?collect-dnt=true"
        alt=""
        referrerpolicy="no-referrer-when-downgrade"
      /></noscript
    >
  </head>
  <body>
    <slot />
  </body>
</html>
