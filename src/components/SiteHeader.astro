---
import logo from "../assets/images/ppologodark.png";
import Text from "./Text.astro";

interface Props {
  homeHref?: string;
  home?: boolean;
}

const { homeHref = "/", home = false } = Astro.props;
---

<header
  class:list={[
    home
      ? "w-full bg-black"
      : "mx-auto w-[min(1040px,calc(100vw-40px))] border-b border-elevated-10",
  ]}
>
  <div
    class:list={[
      "flex flex-col gap-[18px] py-6 pb-[10px] md:flex-row md:items-center",
      home
        ? "mx-auto w-[min(1040px,calc(100vw-40px))] md:justify-end"
        : "md:justify-between",
    ]}
  >
    {
      !home && (
        <a
          href={homeHref}
          aria-label="Project Pixel Orbital home"
          class="flex items-center gap-3 no-underline"
        >
          <img
            src={logo.src}
            alt="Project Pixel Orbital logo"
            class="size-12 object-contain"
          />
          <Text tag="div" variant="subheading">
            Project Pixel Orbital
          </Text>
        </a>
      )
    }

    <nav
      aria-label="Primary"
      class:list={[
        "flex flex-wrap items-center gap-5",
        home && "ml-auto justify-end",
        !home && "md:justify-end",
      ]}
    >
      <a href="/" class="py-2">
        <Text variant="nav" tone="tertiary">Home</Text>
      </a>
      <a href="/blog" class="py-2">
        <Text variant="nav" tone="tertiary">Blog</Text>
      </a>
      <a href="/sponsors" class="py-2">
        <Text variant="nav" tone="tertiary">Sponsors</Text>
      </a>
    </nav>
  </div>
</header>
