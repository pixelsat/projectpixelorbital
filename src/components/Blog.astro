---
import SiteHeader from "./SiteHeader.astro";
import Text from "./Text.astro";

interface Props {
  authors: string;
  title: string;
}

const { authors, title } = Astro.props;
---

<div class="min-h-screen">
  <SiteHeader />

  <main
    id="top"
    class="mx-auto flex w-[min(1040px,calc(100vw-40px))] flex-col gap-8 py-8 pb-[72px] max-md:pb-14"
  >
    <section class="flex flex-col gap-[14px]">
      <Text variant="display" class="max-w-none text-balance">{title}</Text>
      <Text tag="div" variant="caption" tone="tertiary">by {authors}</Text>
    </section>

    <section class="w-full">
      <div
        class="article-prose mx-auto text-[clamp(1rem,0.98rem+0.2vw,1.075rem)] leading-[1.75] text-secondary"
      >
        <slot />
      </div>
    </section>
  </main>
</div>

<style is:global>
  .article-prose * {
    min-width: 0;
    font-weight: 450;
    color: var(--primary);
  }

  .article-prose h1,
  .article-prose h2,
  .article-prose h3,
  .article-prose h4,
  .article-prose h5,
  .article-prose h6 {
    margin: 2.5rem 0 0.9rem;
    line-height: 1.15;
    text-wrap: balance;
    font-weight: 500;
  }

  .article-prose h1 {
    font-size: clamp(2.25rem, 2rem + 1vw, 3rem);
  }

  .article-prose h2 {
    margin-top: 1rem;
    padding-top: 1.5rem;
    font-size: clamp(1.6rem, 1.45rem + 0.5vw, 2rem);
    border-top: 1px solid var(--elevated-10);
  }

  .article-prose h3 {
    font-size: clamp(1.3rem, 1.22rem + 0.35vw, 1.6rem);
  }

  .article-prose h4,
  .article-prose h5,
  .article-prose h6 {
    font-size: 1.05rem;
  }

  .article-prose p,
  .article-prose ul,
  .article-prose ol,
  .article-prose blockquote,
  .article-prose pre,
  .article-prose table,
  .article-prose figure {
    margin: 1.1rem 0;
  }

  .article-prose ul,
  .article-prose ol {
    padding-left: 1.4rem;
  }

  .article-prose ul {
    list-style: disc;
  }

  .article-prose ol {
    list-style: decimal;
  }

  .article-prose li + li {
    margin-top: 0.45rem;
  }

  .article-prose strong {
    color: var(--primary);
    font-weight: 600;
  }

  .article-prose a {
    color: var(--blue);
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.16em;
  }

  .article-prose a:hover {
    color: var(--blue-hover);
  }

  .article-prose blockquote {
    padding: 0.2rem 0 0.2rem 1rem;
    border-left: 3px solid var(--elevated-10);
    color: var(--primary);
  }

  .article-prose hr {
    margin: 2.5rem 0;
    border: 0;
    border-top: 1px solid var(--elevated-10);
  }

  .article-prose code {
    padding: 0.15rem 0.4rem;
    border: 1px solid color-mix(in srgb, var(--primary) 8%, transparent);
    border-radius: 0.45rem;
    background: color-mix(in srgb, var(--primary) 4%, transparent);
    color: var(--primary);
    font-size: 0.92em;
  }

  .article-prose pre {
    overflow-x: auto;
    padding: 1rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--primary) 8%, transparent);
    border-radius: 0.9rem;
    background: #111111;
    color: #f5f5f5;
  }

  .article-prose pre code {
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: inherit;
    font-size: 0.95rem;
  }

  .article-prose img,
  .article-prose video {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    margin: 1.5rem 0;
    border-radius: 1rem;
  }

  .article-prose figcaption {
    margin-top: 0.75rem;
    font-size: 0.95rem;
    color: var(--tertiary);
    text-align: center;
  }

  .article-prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.98rem;
  }

  .article-prose th,
  .article-prose td {
    padding: 0.8rem 0.9rem;
    border-bottom: 1px solid var(--elevated-10);
    text-align: left;
    vertical-align: top;
  }

  .article-prose th {
    color: var(--primary);
    font-weight: 600;
  }

  .article-prose sup {
    font-size: 0.72em;
  }

  .article-prose .footnotes {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--elevated-10);
    font-size: 0.95rem;
  }

  .article-prose .footnotes p {
    margin: 0.7rem 0;
  }
  @media (prefers-color-scheme: dark) {
    .astro-code,
    .astro-code span {
      color: var(--shiki-dark) !important;
      background-color: transparent !important;
      font-style: var(--shiki-dark-font-style) !important;
      font-weight: var(--shiki-dark-font-weight) !important;
      text-decoration: var(--shiki-dark-text-decoration) !important;
    }
  }
</style>
