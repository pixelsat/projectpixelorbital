---
import OuterLink from "./OuterLink.astro";
import IconExternalLink from "./icons/IconExternalLink.astro";
import Text from "./Text.astro";

interface Props {
  title: string;
  desc: string;
  href: string;
  class?: string;
}

const { title, desc, href, class: className } = Astro.props;
---

<OuterLink href={href} button card class:list={["group", "shadow-md", className]}>
  <div class="flex w-full flex-col gap-1 overflow-hidden">
    <Text
      variant="subheading"
      class="transition-colors duration-200 group-hover:text-primary"
      >{title}</Text
    >
    <Text variant="caption" tone="secondary" class="line-clamp-3">{desc}</Text>
  </div>
</OuterLink>
