---
interface Props {
  variant?: "display" | "title" | "heading" | "subheading" | "body" | "body-lg" | "caption" | "eyebrow";
  tone?: "primary" | "secondary" | "tertiary" | "white";
  tag?: keyof astroHTML.JSX.IntrinsicElements;
  center?: boolean;
  class?: string;
}

const {
  variant = "body",
  tone = "primary",
  tag,
  center = false,
  class: className,
} = Astro.props as Props;

const variantClasses = {
  display: "text-[38px] leading-[1.05] tracking-[-0.03em] font-[500] md:text-[43px]",
  title: "text-[30px] leading-[1.1] tracking-[-0.025em] font-[500] md:text-[36px]",
  heading: "text-[24px] leading-[1.2] tracking-[-0.02em] font-[500]",
  subheading: "text-[17px] leading-[1.2] font-[500]",
  body: "text-[16px] leading-[1.22] font-[400]",
  "body-lg": "text-[17px] leading-[1.55] font-[400]",
  caption: "text-[14px] leading-[1.25] font-[400]",
  eyebrow: "text-[13px] leading-[1.2] font-[400]",
} as const;

const toneClasses = {
  primary: "text-primary",
  secondary: "text-secondary",
  tertiary: "text-tertiary",
  white: "text-white",
} as const;

let resolvedTag: keyof astroHTML.JSX.IntrinsicElements;

if (tag) {
  resolvedTag = tag;
} else {
  switch (variant) {
    case "display":
      resolvedTag = "h1";
      break;
    case "title":
      resolvedTag = "h2";
      break;
    case "heading":
      resolvedTag = "h3";
      break;
    case "subheading":
      resolvedTag = "h4";
      break;
    default:
      resolvedTag = "p";
  }
}

const classes = ["m-0", variantClasses[variant], toneClasses[tone], center && "text-center", className];
---

{resolvedTag === "h1" && <h1 class:list={classes}><slot /></h1>}
{resolvedTag === "h2" && <h2 class:list={classes}><slot /></h2>}
{resolvedTag === "h3" && <h3 class:list={classes}><slot /></h3>}
{resolvedTag === "h4" && <h4 class:list={classes}><slot /></h4>}
{resolvedTag === "h5" && <h5 class:list={classes}><slot /></h5>}
{resolvedTag === "h6" && <h6 class:list={classes}><slot /></h6>}
{resolvedTag === "div" && <div class:list={classes}><slot /></div>}
{resolvedTag === "span" && <span class:list={classes}><slot /></span>}
{resolvedTag === "p" && <p class:list={classes}><slot /></p>}
