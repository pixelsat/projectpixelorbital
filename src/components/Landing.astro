  <footer class="mx-auto flex w-[min(1040px,calc(100vw-40px))] snap-start flex-col gap-14 py-14 pb-16">
      <Text tone="tertiary">© 2026 Project Pixel Orbital. All rights reserved.</Text>
  </footer>
</div>

<script>
  const reducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if (!reducedMotion) {
    document.documentElement.classList.add("motion-ready");

    const revealItems = document.querySelectorAll<HTMLElement>(
      "[data-scroll-reveal]",
    );

    const revealObserver = new IntersectionObserver(
      (entries, observer) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: "0px 0px -6%", threshold: 0 },
    );

    revealItems.forEach((item) => revealObserver.observe(item));
  }
</script>
